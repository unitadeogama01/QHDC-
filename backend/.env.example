# ============================================================
#  QHDC! — Configuración del servidor (PLANTILLA)
#  Copia este archivo como ".env" y cambia los valores.
#  .env NO se sube al repositorio (está en .gitignore).
#
#  El mismo código corre en tu computadora y en Hostinger:
#  solo cambian los valores de este archivo.
# ============================================================

# Entorno: "desarrollo" (tu computadora) o "produccion" (Hostinger)
NODE_ENV=desarrollo

# Puerto donde corre la app: http://localhost:3000
PUERTO=3000

# Conexión a MySQL (la base se crea con database/qhdc_base_de_datos.sql)
DB_HOST=localhost
DB_PUERTO=3306
DB_USUARIO=root
DB_CONTRASENA=
DB_NOMBRE=qhdc
# Conexiones simultáneas a MySQL (10 alcanza para ~20 familias usando la app a la vez;
# ver docs/rendimiento.md). En hosting compartido no pases del límite del plan.
DB_CONEXIONES=10

# Zona horaria de las fechas (México centro = -06:00)
ZONA_HORARIA=-06:00

# true  = el servidor simula los ESP32 (para presentar sin hardware)
# false = solo se reciben lecturas de los ESP32 reales (recomendado en producción)
SIMULADOR=false

# Cada cuántos milisegundos manda datos el simulador
SIMULADOR_INTERVALO=3000
# Qué sensores simula: bascula, dht22 o "bascula,dht22".
# Ej.: sin DHT22 todavía → SIMULADOR_SENSORES=dht22 (la báscula espera al hardware real)
SIMULADOR_SENSORES=bascula,dht22
# Con qué dispositivo se conecta: vincúlalo en Dispositivos → Vincular dispositivo
# y copia aquí su identificador y su clave (en una base nueva no existe ninguno).
SIMULADOR_IDENTIFICADOR=
SIMULADOR_CLAVE=

# "true" solo si la app se publica con HTTPS (cookies seguras). En Hostinger: true
COOKIE_SEGURA=false

# En quién confiar para conocer la IP real del visitante (límites de peticiones).
# loopback = solo programas de esta PC (p. ej. el túnel de Cloudflare); 1 = proxy de Hostinger o Nginx.
TRUST_PROXY=loopback

# Límites de peticiones por IP (frenan abusos). Estos son los recomendados:
# súbelos SOLO para pruebas de carga (npm run rendimiento ya lo hace por su cuenta).
LIMITE_API_POR_MINUTO=300
LIMITE_ACCESO_15MIN=40
LIMITE_REGISTRO_HORA=10
LIMITE_FOTOS_10MIN=40
LIMITE_IA_10MIN=60
LIMITE_IOT_POR_MINUTO=120
LIMITE_INTENTOS_ENTRAR=8

# ---------- MQTT: comunicación con los ESP32 ----------
# true = los ESP32 (y el simulador) mandan sus datos por MQTT
MQTT_HABILITADO=true
# true  = el servidor trae su propio broker (Aedes), no hay que instalar nada.
#         Los ESP32 se conectan a la IP de esta computadora, puerto MQTT_PUERTO_INTERNO.
# false = usar un broker externo (Mosquitto en el VPS, HiveMQ Cloud, EMQX Cloud...)
MQTT_BROKER_INTERNO=true
MQTT_PUERTO_INTERNO=1883
# Solo con broker externo, p. ej. mqtts://xxxx.s1.eu.hivemq.cloud:8883
MQTT_URL=
# Usuario/clave del SERVIDOR en el broker (con broker interno la clave se genera sola)
MQTT_USUARIO=qhdc-servidor
MQTT_CLAVE=
# Primer nivel de los topics: despensa/<id-del-esp32>/...
MQTT_PREFIJO=despensa

# ---------- Fotos de alimentos ----------
# Carpeta privada donde se guardan (relativa a backend/). No es pública.
IMAGENES_CARPETA=almacen/imagenes
IMAGEN_MAX_MB=10
# Días que se conserva cada foto; después se borra el archivo (queda el registro)
IMAGENES_RETENCION_DIAS=30

# ---------- Inteligencia artificial (Claude) ----------
# Clave de https://platform.claude.com (Settings → API keys). Sin clave, el
# reconocimiento de fotos funciona en modo de demostración.
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5-5
# Confianza mínima (0 a 1) para marcar un alimento detectado como "guardar"
IA_CONFIANZA_MINIMA=0.6

# ---------- Entrar con Google (opcional) ----------
# ID de cliente OAuth "Aplicación web" de https://console.cloud.google.com
# (APIs y servicios → Credenciales). En "Orígenes autorizados de JavaScript"
# agrega http://localhost:3000 y, en Hostinger, tu dominio con https.
# Vacío = no aparece el botón de Google.
GOOGLE_CLIENT_ID=
